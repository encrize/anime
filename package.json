{
  "name": "aniwired-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "AniWired - Vanilla JS anime streaming frontend with Cloudflare Workers + D1 backend (JWT auth, watch-history sync)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute aniwired --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute aniwired --remote --file=./schema.sql",
    "secret": "wrangler secret put JWT_SECRET"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
